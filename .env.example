# Copy to .env and fill in. NEVER commit .env.
# scripts/install_sdc.sh generates the random secrets for you.

ENVIRONMENT=prod
# Random 64-character value: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
POSTGRES_PASSWORD=
COOKIE_SECURE=true

# First administrator (created only when no users exist). Must be changed at first login.
BOOTSTRAP_ADMIN_USER=admin
BOOTSTRAP_ADMIN_PASSWORD=

# Labels (percent)
THRESHOLD_AI=70
THRESHOLD_HUMAN=30

# Uploads
MAX_UPLOAD_MB=25
# Images smaller than this many pixels (shortest side) are not scored
MIN_IMAGE_SIDE=128
STORE_UPLOADS=false
RETENTION_HOURS=24

# Virus scanning (start ClamAV with: docker compose --profile clamav up -d)
CLAMAV_ENABLED=true
CLAMAV_REQUIRED=false

# Models / hardware
DEVICE=auto
ENABLE_BINOCULARS=true
PRELOAD_MODELS=true
# C2PA_TRUST_ANCHORS_FILE=/models/c2pa_trust_anchors.pem

# Login: local | ldap
AUTH_PROVIDER=local
RATE_LIMIT=20/minute
