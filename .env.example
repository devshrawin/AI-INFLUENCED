# Copy to .env and fill in. NEVER commit .env.
# scripts/install_sdc.sh generates the random secrets for you.

ENVIRONMENT=prod
# Random 64-character value: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
POSTGRES_PASSWORD=
COOKIE_SECURE=true

# First administrator (created only when no users exist). Must be changed at first login.
BOOTSTRAP_ADMIN_USER=admin
BOOTSTRAP_ADMIN_PASSWORD=

# API keys for the scheme platform (comma-separated, 16+ characters each).
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEYS=
API_RATE_LIMIT=600/minute

# Duplicate photos: fingerprint difference (0-64) for "same" and "very similar"
SAME_PHOTO_MAX_DISTANCE=10
SIMILAR_PHOTO_MAX_DISTANCE=16

# Uploads
MAX_UPLOAD_MB=25
STORE_UPLOADS=false
RETENTION_HOURS=24

# Virus scanning (start ClamAV with: docker compose --profile clamav up -d)
CLAMAV_ENABLED=true
CLAMAV_REQUIRED=false

# Optional trusted C2PA root certificates (PEM), placed in ./trust and mounted
# C2PA_TRUST_ANCHORS_FILE=/data/c2pa_trust_anchors.pem

# Login: local | ldap
AUTH_PROVIDER=local
RATE_LIMIT=30/minute
